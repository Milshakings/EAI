# Copia este archivo a .env.local y ajusta si es necesario.

# Servidor local de Ollama (por defecto ya corre en este puerto).
OLLAMA_HOST=http://localhost:11434

# Modelo a usar para generar los borradores D170.
OLLAMA_MODEL=llama3.1:8b

# Secreto para firmar las cookies de sesión. Cambialo en producción.
EVALUAAI_JWT_SECRET=cambia-este-secreto-en-produccion

# Secreto usado para generar y verificar claves de licencia (plan pagado).
# Debe ser el MISMO valor que usas tú al correr scripts/generar-licencia.js
# para este establecimiento. Nunca lo expongas como variable NEXT_PUBLIC_*.
EVALUAAI_LICENSE_SECRET=cambia-este-secreto-de-licencias
